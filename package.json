{
  "name": "quota-orb",
  "version": "1.0.0",
  "description": "Floating desktop widget showing your remaining weekly usage for Codex and Claude.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "author": "yeremyacuna",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.yeremyacuna.quotaorb",
    "productName": "Quota Orb",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "electron": true
  }
}
