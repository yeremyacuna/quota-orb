{
  "name": "quota-orb",
  "version": "1.0.1",
  "description": "Floating desktop widget showing your remaining weekly usage for Codex and Claude.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "security:check": "node tools/check-secrets.js"
  },
  "author": "yeremyacuna",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.yeremyacuna.quotaorb",
    "productName": "Quota Orb",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.png",
      "artifactName": "QuotaOrb-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quota Orb",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "electron": true
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
